# Backend Environment Variables
DATABASE_URL=sqlite:///./screening.db
# For PostgreSQL: postgresql://user:password@localhost:5432/screening_db
SECRET_KEY=change_me_to_a_secure_random_jwt_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
ADMIN_INITIAL_EMAIL=admin@hirenova.com
ADMIN_INITIAL_PASSWORD=change_me_to_a_secure_admin_password_in_production

# =========================================================================
# FRONTEND BASE URL
# Used to construct password-reset links (never use untrusted request Host headers)
# =========================================================================
FRONTEND_BASE_URL=http://localhost:5173

# =========================================================================
# SMTP EMAIL PROVIDER CREDENTIALS
# Required for dispatching password-reset emails to registered users
# Supported: AWS SES, SendGrid, Postmark, Mailgun, Brevo, Gmail SMTP, Custom SMTP
# =========================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key_or_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=HireNova Security
SMTP_TLS=true

# =========================================================================
# GOOGLE OAUTH CONFIGURATION
# Required for "Continue with Google" sign-in / registration
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# =========================================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# =========================================================================
# APPLE OAUTH CONFIGURATION
# Required for "Continue with Apple" sign-in / registration
# Obtain from Apple Developer Portal -> Certificates, Identifiers & Profiles
# =========================================================================
APPLE_CLIENT_ID=com.yourcompany.hirenova.service
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_apple_private_key\n-----END PRIVATE KEY-----"


