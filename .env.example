# ==============================================================================
# AI Resume Screening & Candidate Shortlisting System - Environment Configuration
# Copy this file to .env (or backend/.env and frontend/.env) and populate secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Database URL (Default: SQLite local database file)
# For PostgreSQL in production, use: postgresql://user:password@localhost:5432/screening_db
DATABASE_URL=sqlite:///./backend/screening.db

# JWT Secret Key for authenticating recruiters (generate with: openssl rand -hex 32)
SECRET_KEY=change_me_to_a_secure_random_jwt_secret_key_in_production

# JWT Algorithm and Access Token Expiration (in minutes: 1440 = 24 hours)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
# Backend API Base URL consumed by the Vite client
VITE_API_BASE_URL=http://127.0.0.1:8000
